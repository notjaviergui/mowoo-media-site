# Public, optional HTTPS scheduling link. Blank uses the existing demo request form.
VITE_BOOKING_URL=
# Dedicated demo number only, in E.164 format. Enable each channel after end-to-end testing.
VITE_AGENT_PHONE_NUMBER=+17864630490
VITE_AGENT_VOICE_VERIFIED=true
VITE_AGENT_SMS_VERIFIED=false
# HTTPS URL of your separately deployed Express API. Blank disables newsletter signup.
VITE_API_BASE_URL=

# Public hosted demo. Defaults to the configured Moowo ElevenLabs agent.
VITE_AGENT_DEMO_URL=
VITE_AGENT_DEMO_ENABLED=true
